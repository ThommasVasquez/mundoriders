generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String                    @id @default(uuid())
  username          String?                   @unique
  email             String?                   @unique
  phone             String?                   @unique
  passwordHash      String?
  nombre            String?
  fotoPerfil        String?
  bio               String?
  ciudad            String?
  rutasFrecuentes   String?
  rutaSonada        String?
  nivelExperiencia  NivelExperiencia?         @default(PRINCIPIANTE)
  tipoRider         TipoRider?                @default(URBANO)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  fotoPortada       String?
  accounts          Account[]
  clubMemberships   ClubMember[]
  comments          Comment[]
  conversations     ConversationParticipant[]
  convoyMemberships ConvoyParticipant[]
  crashEvents       CrashEvent[]
  emergencyContacts EmergencyContact[]
  following         Follow[]                  @relation("follower")
  followers         Follow[]                  @relation("following")
  likes             Like[]
  marketplaceItems  MarketplaceItem[]
  messages          Message[]
  motos             Moto[]
  poisCreated       PointOfInterest[]
  posts             Post[]
  ridesOrganized    Ride[]
  rideParticipated  RideParticipant[]
  alertsReported    RoadAlert[]
  routesCreated     Route[]
  routeReviews      RouteReview[]
  sessions          Session[]
  badges            UserBadge[]
  challengeProgress UserChallenge[]
  locations         UserLocation?
  statuses          UserStatus[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Moto {
  id          String   @id @default(uuid())
  userId      String
  marca       String
  modelo      String
  cilindraje  Int
  anio        Int
  apodo       String?
  fotoUrl     String?
  galeria     String[] @default([])
  mods        String[] @default([])
  kilometraje Int      @default(0)
  estado      String   @default("actual")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Badge {
  id          String      @id @default(uuid())
  nombre      String      @unique
  descripcion String
  iconoUrl    String
  createdAt   DateTime    @default(now())
  users       UserBadge[]
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  badgeId   String
  createdAt DateTime @default(now())
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model EmergencyContact {
  id        String   @id @default(uuid())
  userId    String
  nombre    String
  telefono  String
  relacion  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id          String    @id @default(uuid())
  userId      String
  contenido   String
  mediaUrls   String[]
  rutaId      String?
  createdAt   DateTime  @default(now())
  visibilidad String    @default("publico")
  updatedAt   DateTime  @updatedAt
  comments    Comment[]
  likes       Like[]
  route       Route?    @relation(fields: [rutaId], references: [id])
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  contenido String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
}

model Club {
  id           String        @id @default(uuid())
  nombre       String
  slug         String        @unique
  descripcion  String
  ciudad       String
  logoUrl      String?
  verificado   Boolean       @default(false)
  createdAt    DateTime      @default(now())
  members      ClubMember[]
  conversation Conversation?
  rides        Ride[]
}

model ClubMember {
  clubId    String
  userId    String
  rol       RolClub  @default(MIEMBRO)
  createdAt DateTime @default(now())
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clubId, userId])
}

model Route {
  id                  String                  @id @default(uuid())
  nombre              String
  descripcion         String
  creadorId           String
  geometria           Unsupported("geometry")
  dificultad          DificultadRuta          @default(MODERADA)
  tipoVia             TipoVia                 @default(PAVIMENTADA)
  distanciaKm         Float
  duracionEstimadaMin Int
  createdAt           DateTime                @default(now())
  posts               Post[]
  rides               Ride[]
  creador             User                    @relation(fields: [creadorId], references: [id], onDelete: Cascade)
  reviews             RouteReview[]

  @@index([geometria], map: "route_geometria_idx", type: Gist)
}

model RouteReview {
  id         String   @id @default(uuid())
  routeId    String
  userId     String
  rating     Int
  comentario String
  createdAt  DateTime @default(now())
  route      Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([routeId, userId])
}

model PointOfInterest {
  id        String                  @id @default(uuid())
  nombre    String
  tipo      TipoPOI
  ubicacion Unsupported("geometry")
  creadoPor String
  createdAt DateTime                @default(now())
  creador   User                    @relation(fields: [creadoPor], references: [id], onDelete: Cascade)

  @@index([ubicacion], map: "poi_ubicacion_idx", type: Gist)
}

model RoadAlert {
  id           String                  @id @default(uuid())
  tipo         TipoAlertaVial
  ubicacion    Unsupported("geometry")
  descripcion  String
  reportadoPor String
  expiraEn     DateTime
  createdAt    DateTime                @default(now())
  reporter     User                    @relation(fields: [reportadoPor], references: [id], onDelete: Cascade)

  @@index([ubicacion], map: "alert_ubicacion_idx", type: Gist)
}

model Ride {
  id                 String                  @id @default(uuid())
  nombre             String
  rutaId             String?
  organizadorId      String
  clubId             String?
  puntoEncuentro     Unsupported("geometry")
  fechaHora          DateTime
  descripcion        String
  cupoMaximo         Int?
  createdAt          DateTime                @default(now())
  conversation       Conversation?
  convoyParticipants ConvoyParticipant[]
  club               Club?                   @relation(fields: [clubId], references: [id])
  organizador        User                    @relation(fields: [organizadorId], references: [id], onDelete: Cascade)
  route              Route?                  @relation(fields: [rutaId], references: [id])
  participants       RideParticipant[]

  @@index([puntoEncuentro], map: "ride_punto_encuentro_idx", type: Gist)
}

model RideParticipant {
  rideId    String
  userId    String
  estado    EstadoAsistencia @default(PENDIENTE)
  createdAt DateTime         @default(now())
  ride      Ride             @relation(fields: [rideId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([rideId, userId])
}

model Conversation {
  id        String                    @id @default(uuid())
  tipo      TipoConversacion
  rideId    String?                   @unique
  clubId    String?                   @unique
  createdAt DateTime                  @default(now())
  club      Club?                     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  ride      Ride?                     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  members   ConversationParticipant[]
  messages  Message[]
}

model ConversationParticipant {
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  contenido      String
  mediaUrl       String?
  createdAt      DateTime     @default(now())
  leidoPor       String[]
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CrashEvent {
  id                   String                  @id @default(uuid())
  userId               String
  ubicacion            Unsupported("geometry")
  timestamp            DateTime                @default(now())
  confirmadoPorUsuario Boolean?
  alertaEnviada        Boolean                 @default(false)
  datosSensor          Json
  createdAt            DateTime                @default(now())
  user                 User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ubicacion], map: "crash_event_ubicacion_idx", type: Gist)
}

model UserStatus {
  id        String   @id @default(uuid())
  userId    String
  mediaUrl  String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserLocation {
  userId    String                  @id
  ubicacion Unsupported("geometry")
  updatedAt DateTime                @updatedAt
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ubicacion], map: "user_location_idx", type: Gist)
}

model ConvoyParticipant {
  id              String                   @id @default(uuid())
  rideId          String
  userId          String
  rol             String
  ultimaUbicacion Unsupported("geometry")?
  updatedAt       DateTime                 @updatedAt
  ride            Ride                     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([rideId, userId])
  @@index([ultimaUbicacion], map: "convoy_ubicacion_idx", type: Gist)
}

model MarketplaceItem {
  id                       String   @id @default(uuid())
  userId                   String
  titulo                   String
  descripcion              String
  precio                   Float
  categoria                String
  motoModelo               String?
  fotoUrl                  String?
  fotosUrls                String[]
  ciudad                   String
  telefonoContact          String
  createdAt                DateTime @default(now())
  documentoVerificacionUrl String?
  motoOrigenPlaca          String?
  motoOrigenVin            String?
  procedenciaVerificada    Boolean  @default(false)
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CityRestriction {
  id         String   @id @default(uuid())
  ciudad     String   @unique
  picoYPlaca String
  parrillero String
  chaleco    String
  updatedAt  DateTime @updatedAt
}

model Challenge {
  id          String          @id @default(uuid())
  nombre      String          @unique
  descripcion String
  puntos      Int
  medallaName String
  medallaIcon String
  progresses  UserChallenge[]
}

model UserChallenge {
  id           String    @id @default(uuid())
  userId       String
  challengeId  String
  completado   Boolean   @default(false)
  progreso     Float     @default(0.0)
  completadoAt DateTime?
  challenge    Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum NivelExperiencia {
  PRINCIPIANTE
  INTERMEDIO
  AVANZADO
  EXPERTO
}

enum TipoRider {
  TOURING
  URBANO
  OFFROAD
  SPORT
  CUSTOM
}

enum RolClub {
  MIEMBRO
  ADMIN
  FUNDADOR
}

enum DificultadRuta {
  FACIL
  MODERADA
  DIFICIL
  EXPERTO
}

enum TipoVia {
  PAVIMENTADA
  DESTAPADA
  MIXTA
}

enum TipoPOI {
  TALLER
  GASOLINERA
  PARADERO
  MIRADOR
}

enum TipoAlertaVial {
  RETEN
  CLIMA
  VIA_MAL_ESTADO
  DERRUMBE
  ACCIDENTE
}

enum EstadoAsistencia {
  CONFIRMADO
  PENDIENTE
  CANCELADO
}

enum TipoConversacion {
  DIRECTO
  RODADA
  CLUB
}

model AdCampaign {
  id           String       @id @default(uuid())
  sponsorName  String
  titulo       String
  descripcion  String
  targetUrl    String
  bannerUrl    String
  categoria    String       @default("REPUESTOS")
  startDate    DateTime
  endDate      DateTime
  budgetLimit  Float
  active       Boolean      @default(true)
  clicks       AdAnalytic[]
  impressions  Int          @default(0)
  createdAt    DateTime     @default(now())
}

model AdAnalytic {
  id         String     @id @default(uuid())
  campaignId String
  userId     String?
  ipAddress  String?
  device     String?
  createdAt  DateTime   @default(now())
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model SponsoredPOI {
  id          String   @id @default(uuid())
  poiName     String
  latitude    Float
  longitude   Float
  promocion   String
  clicksCount Int      @default(0)
  visitsCount Int      @default(0)
  createdAt   DateTime @default(now())
}
